{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soksak:spec:registry:0.0.1",
  "title": "soksak signed registry index 0.0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "registryId",
    "sequence",
    "issuedAt",
    "expiresAt",
    "units",
    "signature"
  ],
  "properties": {
    "spec": { "const": "soksak-spec-registry@0.0.1" },
    "registryId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issuedAt": { "$ref": "#/$defs/timestamp" },
    "expiresAt": { "$ref": "#/$defs/timestamp" },
    "units": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/unit" }
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "unitId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "semver": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "releaseAssetUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9][A-Za-z0-9._-]{0,99}/releases/download/[^/?#]+/[a-z0-9][a-z0-9._-]{0,254}$"
    },
    "integrityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256"],
      "properties": {
        "url": { "$ref": "#/$defs/releaseAssetUrl" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "manifest", "reports"],
      "properties": {
        "kind": { "enum": ["kit", "plugin", "sidecar"] },
        "id": { "$ref": "#/$defs/unitId" },
        "version": { "$ref": "#/$defs/semver" },
        "manifest": { "$ref": "#/$defs/integrityReference" },
        "reports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/integrityReference" }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "keyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "value": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4}){21}[A-Za-z0-9+/]{2}==$"
        }
      }
    }
  }
}
