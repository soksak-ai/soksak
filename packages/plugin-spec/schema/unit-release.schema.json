{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soksak:spec:release:0.0.1",
  "title": "soksak unit owner release manifest 0.0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "kind",
    "id",
    "version",
    "source",
    "releaseTag",
    "dependencies",
    "artifacts"
  ],
  "properties": {
    "spec": { "const": "soksak-spec-release@0.0.1" },
    "kind": { "enum": ["kit", "plugin", "sidecar"] },
    "id": { "$ref": "#/$defs/unitId" },
    "version": { "$ref": "#/$defs/semver" },
    "source": { "$ref": "#/$defs/source" },
    "releaseTag": {
      "type": "string",
      "minLength": 2,
      "maxLength": 512
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "kind": { "const": "plugin" } }, "required": ["kind"] },
      "then": {
        "type": "object",
        "properties": {
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "$ref": "#/$defs/pluginArtifact" }
          }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "kind": { "const": "kit" } }, "required": ["kind"] },
      "then": {
        "type": "object",
        "properties": {
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "$ref": "#/$defs/kitArtifact" }
          }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "kind": { "const": "sidecar" } }, "required": ["kind"] },
      "then": {
        "type": "object",
        "properties": {
          "artifacts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/sidecarArtifact" }
          }
        }
      }
    }
  ],
  "$defs": {
    "unitId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "semver": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "repositoryUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "releaseAssetUrl": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9][A-Za-z0-9._-]{0,99}/releases/download/[^/?#]+/[a-z0-9][a-z0-9._-]{0,254}$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?=[\\x20-\\x7E]+$)(?!/)(?!.*//)(?!.*[<>:\"\\\\|?*])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)[^/]{256})(?!.*[ .](?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*|/|$)).+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "$ref": "#/$defs/repositoryUrl" },
        "commit": { "$ref": "#/$defs/commit" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "range"],
      "properties": {
        "kind": { "enum": ["kit", "plugin", "sidecar"] },
        "id": { "$ref": "#/$defs/unitId" },
        "range": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "artifactBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "url", "sha256", "format", "entrypoint"],
      "properties": {
        "target": {},
        "url": { "$ref": "#/$defs/releaseAssetUrl" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "format": { "enum": ["tar.gz", "tgz"] },
        "entrypoint": {}
      }
    },
    "pluginArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifactBase" },
        {
          "type": "object",
          "properties": {
            "target": { "const": "any" },
            "entrypoint": { "$ref": "#/$defs/pluginEntrypoint" }
          }
        }
      ]
    },
    "kitArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifactBase" },
        {
          "type": "object",
          "properties": {
            "target": { "const": "any" },
            "entrypoint": { "$ref": "#/$defs/kitEntrypoint" }
          }
        }
      ]
    },
    "sidecarArtifact": {
      "allOf": [
        { "$ref": "#/$defs/artifactBase" },
        {
          "type": "object",
          "properties": {
            "target": {
              "enum": [
                "aarch64-apple-darwin",
                "aarch64-pc-windows-msvc",
                "aarch64-unknown-linux-gnu",
                "aarch64-unknown-linux-musl",
                "x86_64-apple-darwin",
                "x86_64-pc-windows-msvc",
                "x86_64-unknown-linux-gnu",
                "x86_64-unknown-linux-musl"
              ]
            },
            "entrypoint": { "$ref": "#/$defs/sidecarEntrypoint" }
          }
        }
      ]
    },
    "pluginEntrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "manifest"],
      "properties": {
        "kind": { "const": "plugin" },
        "manifest": { "$ref": "#/$defs/safePath" }
      }
    },
    "kitEntrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "packageManifest"],
      "properties": {
        "kind": { "const": "kit" },
        "packageManifest": { "$ref": "#/$defs/safePath" }
      }
    },
    "namedPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path"],
      "properties": {
        "name": { "$ref": "#/$defs/unitId" },
        "path": { "$ref": "#/$defs/safePath" }
      }
    },
    "sidecarEntrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "interface"],
      "properties": {
        "kind": { "const": "sidecar" },
        "interface": { "$ref": "#/$defs/sidecarContractProvider" },
        "process": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namedPath" }
        },
        "library": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namedPath" }
        }
      },
      "anyOf": [
        { "type": "object", "properties": { "process": {} }, "required": ["process"] },
        { "type": "object", "properties": { "library": {} }, "required": ["library"] }
      ]
    },
    "sidecarContractProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^soksak-spec-sidecar-[a-z0-9][a-z0-9-]*$"
        },
        "version": { "$ref": "#/$defs/semver" }
      }
    }
  }
}
