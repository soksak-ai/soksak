{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soksak:spec:conformance:0.0.1",
  "title": "soksak conformance report 0.0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "subject", "contract", "result", "validator", "artifacts"],
  "properties": {
    "spec": { "const": "soksak-spec-conformance@0.0.1" },
    "subject": { "$ref": "#/$defs/subject" },
    "contract": {
      "anyOf": [
        {
          "enum": [
            "soksak-spec-kit@0.0.1",
            "soksak-spec-plugin@0.0.1",
            "soksak-spec-release@0.0.1",
            "soksak-spec-sidecar@0.0.1"
          ]
        },
        {
          "$ref": "#/$defs/contractProvider"
        }
      ]
    },
    "result": { "const": "passed" },
    "validator": { "$ref": "#/$defs/validator" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "unitId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,127}$"
    },
    "semver": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "contractId": {
      "type": "string",
      "pattern": "^soksak-spec-(?:(?:sidecar|plugin)-[a-z0-9][a-z0-9-]*|service(?:-[a-z0-9][a-z0-9-]*)?)$"
    },
    "contractProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/contractId" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target": {
      "enum": [
        "any",
        "aarch64-apple-darwin",
        "aarch64-pc-windows-msvc",
        "aarch64-unknown-linux-gnu",
        "aarch64-unknown-linux-musl",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "manifestSha256"],
      "properties": {
        "kind": { "enum": ["kit", "plugin", "sidecar"] },
        "id": { "$ref": "#/$defs/unitId" },
        "version": { "$ref": "#/$defs/semver" },
        "manifestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/unitId" },
        "version": { "$ref": "#/$defs/semver" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "sha256"],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
