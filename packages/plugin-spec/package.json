{
  "name": "@soksak-ai/plugin-spec",
  "version": "0.2.0",
  "description": "soksak plugin manifest spec and headless parseManifest validator (single source of truth).",
  "license": "MIT",
  "author": "soksak-ai",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soksak-ai/soksak.git",
    "directory": "packages/plugin-spec"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/spec.d.ts",
      "default": "./dist/spec.js"
    }
  },
  "bin": {
    "soksak-validate": "bin/validate.mjs"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
