<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="soksak.exe"
        Arguments=""
        InstallLocation="C:\Program Files\soksak\soksak">
    </Installer>
    <PackageInformation
        PackageName="soksak"
        PackageDisplayName="soksak"
        PublisherName="CN=soksak"
        PublisherDisplayName="soksak"
        Version="0.0.3.0"
        PackageDescription="Plugin-driven recursive terminal and browser workspace">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.soksak.core"
                Description="Plugin-driven recursive terminal and browser workspace"
                DisplayName="soksak"
                ExecutableName="soksak.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>soksak</DisplayName>
            <PublisherDisplayName>soksak</PublisherDisplayName>
            <Description>Plugin-driven recursive terminal and browser workspace</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="soksak.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
