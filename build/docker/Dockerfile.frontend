ARG NODE_VERSION=must-be-provided
FROM node:${NODE_VERSION}-bookworm
ARG PNPM_VERSION=must-be-provided
ARG FRONTEND_DEFINITION_SHA
LABEL io.soksak.frontend.definition-sha="$FRONTEND_DEFINITION_SHA"
ENV NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false PNPM_DISABLE_SELF_UPDATE_CHECK=1
RUN npm install --global --no-update-notifier --no-fund "pnpm@$PNPM_VERSION" \
    && node --version | grep -Fx "v$NODE_VERSION" \
    && pnpm --version | grep -Fx "$PNPM_VERSION"
WORKDIR /app/frontend
