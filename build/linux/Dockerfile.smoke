FROM wails-cross

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    dbus-x11 gnome-keyring imagemagick scrot xauth xdotool xvfb \
    && rm -rf /var/lib/apt/lists/*

COPY smoke.sh /usr/local/bin/soksak-linux-smoke
RUN chmod +x /usr/local/bin/soksak-linux-smoke

ENTRYPOINT ["/usr/local/bin/soksak-linux-smoke"]
